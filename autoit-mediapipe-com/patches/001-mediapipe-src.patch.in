diff --git a/mediapipe/tasks/cc/core/base_options.h b/mediapipe/tasks/cc/core/base_options.h
index d09ffd022..bc0194657 100644
--- a/mediapipe/tasks/cc/core/base_options.h
+++ b/mediapipe/tasks/cc/core/base_options.h
@@ -121,6 +121,32 @@ struct BaseOptions {
 
   // The path to the CA bundle file.
   std::string ca_bundle_path;
+
+  BaseOptions& operator=(const BaseOptions& rhs) {
+    auto& lhs = *this;
+
+    lhs.model_asset_buffer = rhs.model_asset_buffer
+        ? std::make_unique<std::string>(*rhs.model_asset_buffer)
+        : nullptr;
+
+    lhs.model_asset_path = rhs.model_asset_path;
+    lhs.delegate = rhs.delegate;
+    lhs.model_asset_descriptor_meta = rhs.model_asset_descriptor_meta;
+
+    // copy is not possible
+    // lhs.op_resolver =
+    //     ? std::make_unique<MediaPipeBuiltinOpResolver>(*rhs.op_resolver)
+    //     : nullptr;
+
+    lhs.delegate_options = rhs.delegate_options;
+    lhs.disable_default_service = rhs.disable_default_service;
+    lhs.host_environment = rhs.host_environment;
+    lhs.host_system = rhs.host_system;
+    lhs.host_version = rhs.host_version;
+    lhs.ca_bundle_path = rhs.ca_bundle_path;
+
+    return lhs;
+  }
 };
 
 // Converts a BaseOptions to a BaseOptionsProto.
